{
  "name": "@10xcodereview/code-reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.12" },
  "description": "AI-powered code reviewer built on the Vercel AI SDK + OpenRouter",
  "main": "dist/agent/index.js",
  "types": "dist/agent/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.79",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
