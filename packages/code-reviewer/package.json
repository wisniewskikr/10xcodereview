{
  "name": "@10xcodereview/code-reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "description": "AI-powered code reviewer built on the Vercel AI SDK + OpenRouter",
  "main": "dist/agent/index.js",
  "types": "dist/agent/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "ci": "tsx src/ci.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"eval/**/*.test.ts\"",
    "eval:schema": "tsx eval/gen-schema.ts",
    "eval": "npm run build && npm run eval:schema && promptfoo eval -c eval/promptfooconfig.yaml -o eval-results.json -o eval-results.html",
    "eval:mock": "npm run build && npm run eval:schema && promptfoo eval -c eval/promptfooconfig.mock.yaml"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.79",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "promptfoo": "^0.122.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
